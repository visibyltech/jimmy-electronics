rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && (
        request.auth.token.email in ['mindjemulticoncept@gmail.com', 'usitakatelvin@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function ownData() { return request.resource.data.userId == request.auth.uid; }
    function sameOwner() { return resource.data.userId == request.auth.uid; }

    match /{document=**} { allow read, write: if false; }

    match /test/{id} {
      allow get: if id == 'connection';
    }

    match /products/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /brands/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /settings/{id} {
      allow read: if true;
      allow create, update: if admin();
      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create, update: if owner(uid) || admin();
      allow delete: if false;

      match /addresses/{addressId} {
        allow read, write: if owner(uid) || admin();
      }
    }

    match /orders/{id} {
      allow get, list: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && ownData();
      allow update: if admin() || (
        signedIn() &&
        sameOwner() &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.orderRef == resource.data.orderRef &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus', 'updatedAt']) &&
        request.resource.data.orderStatus == 'cancelled'
      );
      allow delete: if false;
    }

    match /payments/{id} {
      allow get, list: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && ownData() &&
        request.resource.data.status == 'pending_verification';
      allow update: if admin();
      allow delete: if false;
    }

    match /receipts/{id} {
      allow get, list: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && ownData();
      allow update: if admin();
      allow delete: if false;
    }

    match /instalment_plans/{id} {
      allow get, list: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && ownData() &&
        request.resource.data.adminApproved == false &&
        request.resource.data.amountPaidVerifiedNgn == 0;
      allow update: if admin();
      allow delete: if false;
    }

    match /notifications/{id} {
      allow get, list: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if admin() || (signedIn() && ownData());
      allow update: if admin() || (
        signedIn() &&
        sameOwner() &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
      allow delete: if admin();
    }

    match /admins/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create, update, delete: if signedIn() &&
        request.auth.token.email in ['mindjemulticoncept@gmail.com', 'usitakatelvin@gmail.com'];
    }
  }
}